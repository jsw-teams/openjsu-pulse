{
  "version": 1,
  "intervalMinutes": 5,
  "timeoutMs": 10000,
  "historyLimit": 12,
  "dns": {
    "query": "example.com"
  },
  "targets": [
    {
      "id": "blog",
      "name": "blog.openjsu.com",
      "role": "博客",
      "type": "http",
      "url": "https://blog.openjsu.com",
      "description": "OpenJSU 内容与技术博客",
      "degradedAboveMs": 1200
    },
    {
      "id": "dns",
      "name": "dns.openjsu.com",
      "role": "递归解析器",
      "type": "dns",
      "host": "dns.openjsu.com",
      "query": "example.com",
      "description": "OpenJSU 公共递归 DNS 服务",
      "degradedAboveMs": 500
    },
    {
      "id": "portal",
      "name": "openjsu.com",
      "role": "门户",
      "type": "http",
      "url": "https://openjsu.com",
      "description": "OpenJSU 主门户与服务入口",
      "degradedAboveMs": 1200
    }
  ]
}
